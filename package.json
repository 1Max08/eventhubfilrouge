{
  "name": "eventhub",
  "version": "1.0.0",
  "private": true,
  "description": "EventHub - plateforme de gestion d'événements et de billetterie",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md,yml}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1Max08/eventhubfilrouge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
